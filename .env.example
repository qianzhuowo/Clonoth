# ===========================================================================
# Clonoth 环境变量配置
# 复制本文件为 .env 并填入实际值。
# .env 已在 .gitignore 中排除，不会被提交到仓库。
# ===========================================================================

# ---------------------------------------------------------------------------
# Supervisor 配置
# ---------------------------------------------------------------------------

# 监听地址和端口（默认 127.0.0.1:8765）
# CLONOTH_HOST=127.0.0.1
# CLONOTH_PORT=8765

# 日志级别（debug / info / warning / error）
# CLONOTH_LOG_LEVEL=info

# Admin API 认证 token。留空则自动生成并写入 data/admin_token.txt。
# CLONOTH_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 默认 LLM Provider（OpenAI 兼容）
# ---------------------------------------------------------------------------
# 这是全局默认的 LLM 配置。所有 provider 在没有独立配置时会 fallback 到这里。
# 也可以在 data/config.yaml 中用 ${ENV_VAR} 语法引用这些变量。

# API 端点（OpenAI 官方或任意兼容端点）
OPENAI_BASE_URL=https://api.openai.com/v1

# API Key
OPENAI_API_KEY=sk-your-key-here

# 默认模型
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 其他 Provider（可选，按需配置）
# ---------------------------------------------------------------------------
# 未配置时会 fallback 到上面的 OPENAI_* 全局配置。

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# DeepSeek
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini
# GEMINI_API_KEY=your-gemini-key
# GEMINI_BASE_URL=

# ---------------------------------------------------------------------------
# 系统模型（可选）
# 优先用 设置 → 模型与渠道 → 系统模型（data/config.yaml 的 system_models.<槽位>）；这里是环境变量写法。
# 槽位：COMPACT 上下文压缩、SUMMARY 轮次摘要、MEMORY 记忆提取。
# 都留空时跟随当前全局渠道和模型；只填 MODEL 时用全局渠道的地址和密钥。
# ---------------------------------------------------------------------------
# CLONOTH_COMPACT_PROVIDER=
# CLONOTH_COMPACT_MODEL=
# CLONOTH_COMPACT_BASE_URL=
# CLONOTH_COMPACT_API_KEY=
# CLONOTH_SUMMARY_MODEL=
# CLONOTH_MEMORY_MODEL=

# ---- 搜索与远程执行工具 ----
# search_web：按 tinyfish -> parallel（免 Key）-> exa 顺序回退；key 也可放 data/keys_tinyfish.txt / data/keys_exa.txt
TINYFISH_API_KEY=
EXA_API_KEY=
# search_web 的 X/Twitter 搜索（xAI）：只有配置 XAI_API_KEY 才启用，与网页搜索同时进行；留空则只搜网页
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.3
# remote_exec 的 SSH 目标：~/.ssh/config 别名或 user@host
REMOTE_EXEC_HOST=

# ---- 生图渠道 ----
# 通用/写实生图（gpt_image_2），留空回退 OPENAI_BASE_URL / OPENAI_API_KEY
CLONOTH_IMAGE_GPT_BASE_URL=
CLONOTH_IMAGE_GPT_API_KEY=
# CLONOTH_IMAGE_GPT_MODEL=gpt-image-2
# Gemini 生图（gemini_image），留空回退 GEMINI_* / OPENAI_*
CLONOTH_IMAGE_GEMINI_BASE_URL=
CLONOTH_IMAGE_GEMINI_API_KEY=
# CLONOTH_IMAGE_GEMINI_MODEL=gemini-3-pro-image-preview
# NovelAI（drawtools），也可写在 tools/drawtools/settings.yaml 的 api.api_key
NOVELAI_API_KEY=
# 绘图分析节点（draw.novelai_planner / draw.image_gen）使用的文本模型渠道
DRAW_TAG_MODEL=
DRAW_TAG_BASE_URL=
DRAW_TAG_API_KEY=

# 识图模型：read_media（看图/看视频）和“不能识图的模型收到图片时的自动转写”都用它。
# 优先用 设置 → 模型与渠道 → 识图模型（data/config.yaml 的 system_models.vision）；这里是环境变量写法。
# 走 Gemini 原生格式（generateContent）。留空时模型默认 gemini-3.8-flash，key/地址依次取 GEMINI_*、OPENAI_*。
CLONOTH_VISION_MODEL=
CLONOTH_VISION_BASE_URL=
CLONOTH_VISION_API_KEY=

# ── OneBot（QQ）反向 WebSocket 监听 ──
# NapCat 主动连接 ws://<ONEBOT_HOST>:<ONEBOT_PORT>/onebot/v11/ws。
# 默认只监听 127.0.0.1；NapCat 在 docker 中时通常需监听 docker 网桥网关（如 172.17.0.1）。
# 监听非回环地址时必须设置 token（与 NapCat 反向 WS 配置的 token 相同），否则拒绝启动。
ONEBOT_HOST=127.0.0.1
ONEBOT_PORT=8080
ONEBOT_ACCESS_TOKEN=
# 过渡期临时放行无 token 的非回环监听（不建议长期开启）
# ONEBOT_ALLOW_NO_TOKEN=1

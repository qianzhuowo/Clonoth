*.sqlite3
*.sqlite3-journal
*.db-wal
*.db-shm

# Runtime secrets/state that must never leave the host, even outside /data
**/.admin_token
**/web_auth.json
**/llm_error_snapshots/

# Ad-hoc deploy bundles at the repo root
/*.tgz
/*.tar.gz
/*.zip
# git bundles used for offline deploys
*.bundle

# Frontend test coverage (JS)
.nyc_output/


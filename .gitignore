.env
.env.*
!.env.example
*.local
*.secret
*.secrets
*.pem
*.key

# Runtime state and local data
/data/
/logs/
/tmp/
/temp/
*.log
*.pid
*.sock
# Live config belongs in data/ (data/config.yaml, data/policy.yaml); stray root copies stay local
/config.yaml
/policy.yaml


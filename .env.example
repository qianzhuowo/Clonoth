# ===========================================================================
# Clonoth 环境变量配置
# 复制本文件为 .env 并填入实际值。
# .env 已在 .gitignore 中排除，不会被提交到仓库。
# ===========================================================================

# ---------------------------------------------------------------------------
# Supervisor 配置
# ---------------------------------------------------------------------------

# 监听地址和端口（默认 127.0.0.1:8765）
# CLONOTH_HOST=127.0.0.1
# CLONOTH_PORT=8765

# 日志级别（debug / info / warning / error）
# CLONOTH_LOG_LEVEL=info

# Admin API 认证 token。留空则自动生成并写入 data/admin_token.txt。
# CLONOTH_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 默认 LLM Provider（OpenAI 兼容）
# ---------------------------------------------------------------------------
# 这是全局默认的 LLM 配置。所有 provider 在没有独立配置时会 fallback 到这里。
# 也可以在 data/config.yaml 中用 ${ENV_VAR} 语法引用这些变量。

# API 端点（OpenAI 官方或任意兼容端点）
OPENAI_BASE_URL=https://api.openai.com/v1

# API Key
OPENAI_API_KEY=sk-your-key-here

# 默认模型
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 其他 Provider（可选，按需配置）
# ---------------------------------------------------------------------------
# 未配置时会 fallback 到上面的 OPENAI_* 全局配置。

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# DeepSeek
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini
# GEMINI_API_KEY=your-gemini-key
# GEMINI_BASE_URL=

# ---------------------------------------------------------------------------
# 功能模块模型（可选，覆盖默认模型）
# ---------------------------------------------------------------------------

# 记忆提取使用的模型
# MEMORY_EXTRACT_MODEL=gpt-4o-mini

# 上下文压缩使用的模型
# COMPACT_MODEL=gpt-4o-mini

# ---- 搜索与远程执行工具 ----
# web_search 根据已配置的 key 自动选择 Exa 或 X 搜索（可用 WEB_SEARCH_PROVIDER=exa|x 指定）
EXA_API_KEY=
# EXA_BASE_URL=
XAI_API_KEY=
# XAI_BASE_URL=
# WEB_SEARCH_PROVIDER=
# remote_exec 的 SSH 目标：~/.ssh/config 别名或 user@host
REMOTE_EXEC_HOST=

# ---- 生图渠道 ----
# 通用/写实生图（gpt_image_2），留空回退 OPENAI_BASE_URL / OPENAI_API_KEY
CLONOTH_IMAGE_GPT_BASE_URL=
CLONOTH_IMAGE_GPT_API_KEY=
# CLONOTH_IMAGE_GPT_MODEL=gpt-image-2
# Gemini 生图（gemini_image），留空回退 GEMINI_* / OPENAI_*
CLONOTH_IMAGE_GEMINI_BASE_URL=
CLONOTH_IMAGE_GEMINI_API_KEY=
# CLONOTH_IMAGE_GEMINI_MODEL=gemini-3-pro-image-preview
# NovelAI（drawtools），也可写在 tools/drawtools/settings.yaml 的 api.api_key
NOVELAI_API_KEY=

.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.dmypy.json
.coverage
.coverage.*
*.cover
htmlcov/
.ipynb_checkpoints/

# Virtual environments and local Python packaging output
.venv/
.venv*/
venv/
env/
ENV/
build/
dist/
*.egg-info/
*.egg
.eggs/
*.whl
pip-wheel-metadata/

# Node and frontend generated output
node_modules/
**/node_modules/
.npm/
.pnpm-store/
adapters/web/frontend/dist/
adapters/web/frontend/.vite/
**/coverage/
*.tsbuildinfo
.eslintcache
vite.config.*.timestamp-*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
